# cp .env.example .env, fill the secrets. Used by docker compose.
# CHAMPMAIL_ENV=production fails startup if the two secrets below are empty.
CHAMPMAIL_ENV=development
POSTGRES_PASSWORD=champmail
DATABASE_URL=postgresql+psycopg://champmail:champmail@postgres:5432/champmail
REDIS_URL=redis://redis:6379/0
CHAMPMAIL_API_KEY=
CHAMPMAIL_WEBHOOK_SECRET=

# SMTP (defaults point at the bundled Mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# InboxKit placeholders
INBOXKIT_API_KEY=
INBOXKIT_BASE_URL=
INBOXKIT_WEBHOOK_SECRET=
