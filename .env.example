# cp .env.example .env, fill the secrets. Used by docker compose.
# CHAMPMAIL_ENV=production fails startup if the two secrets below are empty.
CHAMPMAIL_ENV=development
POSTGRES_PASSWORD=champmail
DATABASE_URL=postgresql+psycopg://champmail:champmail@postgres:5432/champmail
REDIS_URL=redis://redis:6379/0
CHAMPMAIL_API_KEY=
CHAMPMAIL_WEBHOOK_SECRET=
# Client that receives outbound events, e.g. https://harbinger.example.com
CHAMPMAIL_CLIENT_URL=

# SMTP (defaults point at the bundled Mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# InboxKit placeholders
INBOXKIT_API_KEY=
INBOXKIT_BASE_URL=
INBOXKIT_WEBHOOK_SECRET=
INBOXKIT_WORKSPACE_ID=

# Credential encryption at rest (app.crypto). Keys come from env only and are
# required before any mailbox credential can be written; generate one with:
#   python3 -c "import os; print(os.urandom(32).hex())"
EMAIL_ENCRYPTION_KEY=

# HMAC key that signs open/click tracking links (required, same value on every instance, never rotate
# casually: links already sent stop working). Generate with:
#   python3 -c "import os; print(os.urandom(32).hex())"
TRACKING_SECRET=
