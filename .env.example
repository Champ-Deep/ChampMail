# cp .env.example .env, fill the secrets. Used by docker compose.
# CHAMPMAIL_ENV=production fails startup if the two secrets below are empty.
CHAMPMAIL_ENV=development
POSTGRES_PASSWORD=champmail
DATABASE_URL=postgresql+psycopg://champmail:champmail@postgres:5432/champmail
REDIS_URL=redis://redis:6379/0
CHAMPMAIL_API_KEY=
CHAMPMAIL_WEBHOOK_SECRET=
# Client that receives outbound events, e.g. https://harbinger.example.com
CHAMPMAIL_CLIENT_URL=

# SMTP (defaults point at the bundled Mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# InboxKit placeholders
INBOXKIT_API_KEY=
INBOXKIT_BASE_URL=
INBOXKIT_WEBHOOK_SECRET=
INBOXKIT_WORKSPACE_ID=

# Credential encryption at rest (app.crypto). Keys come from env only and are
# required before any mailbox credential can be written; generate one with:
#   python3 -c "import os; print(os.urandom(32).hex())"
EMAIL_ENCRYPTION_KEY=

# HMAC key that signs open/click tracking links (required, same value on every instance, never rotate
# casually: links already sent stop working). Generate with:
#   python3 -c "import os; print(os.urandom(32).hex())"
TRACKING_SECRET=

# Edge Worker (edge/): the Worker posts opened/clicked/unsubscribed here with this shared secret
# (X-Edge-Secret). Blank refuses every Worker callback. Same value as `wrangler secret put INTERNAL_EVENTS_SECRET`.
INTERNAL_EVENTS_SECRET=

# Cloudflare DNS automation on POST /api/v1/domains. Blank token: off, nothing is touched.
# Token scopes: Zone:Read, DNS:Edit, Workers Routes:Edit. EDGE_WORKER_HOSTNAME is the track.<domain> CNAME target.
CLOUDFLARE_API_TOKEN=
EDGE_WORKER_HOSTNAME=
EDGE_WORKER_SCRIPT=champmail-edge

# DMARC aggregate reports: the rua mailbox ({brand} becomes the brand id), and the IMAP login that reads it.
# Blank DMARC_IMAP_HOST: ingestion is skipped.
DMARC_RUA_ADDRESS=
DMARC_IMAP_HOST=
DMARC_IMAP_PORT=993
DMARC_IMAP_SSL=true
DMARC_IMAP_USER=
DMARC_IMAP_PASSWORD=
DMARC_IMAP_FOLDER=INBOX

# Google Postmaster Tools: the service account key JSON on one line. Blank: the postmaster_* fields stay null.
POSTMASTER_SERVICE_ACCOUNT_JSON=

# Extra DKIM selectors the daily health check tries, comma separated, besides each domain's own dkim_selector.
DKIM_SELECTORS=
